// Core Phase 1 data model — see docs/superpowers/specs/2026-09-08-art-atlas-product-definition-and-sitemap.md
// and .scratch/art-atlas-mvp/issues/02-core-data-model.md for the ticket this implements.
//
// Deliberate distinctions preserved here (master prompt §10):
// - Artwork is the named artistic work/concept; PhysicalObject is one physical impression
//   of it. A single-object painting has exactly one PhysicalObject; a series or an edition
//   has many, each with its own identifiers/dimensions/location history.
// - MovementStyle.kind distinguishes period / movement / technique / style rather than
//   conflating them under one label.
// - Assertion is a generic, polymorphic fact table: every field on every entity that came
//   from a source is recorded here (not just written directly onto the entity), so multiple
//   conflicting values, their sources, and the preferred one can all be preserved.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Artwork {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  artistId       String?
  // Free text, honestly null when the source gives nothing — Met's `culture` field
  // (populated mainly for anonymous/non-Western objects, empty for most named-artist
  // European paintings) and AIC's `place_of_origin` (a specific place, not a culture
  // label) aren't the same granularity; stored as whichever the source actually gave,
  // not normalized into a shared vocabulary — that would need Getty TGN reconciliation
  // (§8), not attempted here. Powers "What else was happening then?" (§5).
  placeOrCulture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  artist                 Artist?           @relation(fields: [artistId], references: [id])
  physicalObjects        PhysicalObject[]
  movements              ArtworkMovement[]
  duplicateFlagsAsA      DuplicateFlag[]   @relation("DuplicateFlagArtworkA")
  duplicateFlagsAsB      DuplicateFlag[]   @relation("DuplicateFlagArtworkB")
  relationshipsAsSubject Relationship[]    @relation("RelationshipSubject")
  relationshipsAsObject  Relationship[]    @relation("RelationshipObject")

  @@index([artistId])
}

model PhysicalObject {
  id                String   @id @default(cuid())
  artworkId         String
  institutionId     String?
  accessionNumber   String?
  medium            String?
  dimensions        String?
  // The source's own canonical record URL for this exact physical object — the real
  // identity key bulk ingestion upserts against (ticket 05). Two different source
  // records can normalize to the same Artwork.slug (e.g. two different "Self-Portrait"
  // paintings); slug alone must never decide whether they're the same physical object.
  externalRecordUrl String?  @unique
  // "on_display" | "not_on_display" | "unconfirmed" — plain string, same rationale as
  // MovementStyle.kind. Defaults honestly to unconfirmed: §7's rule is that an
  // institution owning a work never by itself establishes it's on display, and none of
  // our sources give us a live display feed yet (that's location-freshness work, §3
  // Phase 2). Filterable (ticket 07) and shown on Family Explorer cards (ticket 09)
  // regardless — an honest "unconfirmed" is still real, functioning data.
  displayStatus     String   @default("unconfirmed")
  // "museum_access" | "appointment" | "private_no_access" | "unknown" — §7's public-access
  // concept, distinct from displayStatus (an institution can hold a work with full public
  // museum access even while that specific piece is off view). Defaults to museum_access,
  // not "unknown": every current source (Met, AIC) is a public museum — a verified,
  // stable institutional fact, not a per-object guess. A future private-collection source
  // would need to override this explicitly at ingest time.
  publicAccess      String   @default("museum_access")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  artwork          Artwork           @relation(fields: [artworkId], references: [id])
  institution      Institution?      @relation(fields: [institutionId], references: [id])
  images           ImageAsset[]
  ownershipEvents  OwnershipEvent[]
  exhibitionEvents ExhibitionEvent[]

  @@index([artworkId])
  @@index([institutionId])
}

// §6 "Ownership journey" / §10 OwnershipEvent, Exhibition/LoanEvent (ticket 25, Phase 2).
// Tied to PhysicalObject, not Artwork — provenance is a specific physical object's
// history (§10: "A physical object has its own ... condition/location history"), not the
// abstract work/concept's.
//
// Sourced from AIC's `provenance_text` field (Met's API has no equivalent — confirmed
// live, see ticket 25's file) — real museum-published scholarly provenance research, but
// unstructured prose, not discrete structured fields. Deliberately NOT parsed into
// separate owner-name/date/transfer-type columns: that would require confidently
// distinguishing an owner from an agent ("sold... as the agent for Knoedler and Company"
// — the agent is explicitly NOT the owner in the source text) and extracting dates from
// inconsistent phrasing, both real risks of misattribution the master prompt explicitly
// warns against (§6: "do not infer identities"). Instead: the source's own text is split
// into discrete segments (semicolon-separated, respecting bracket/paren nesting so a
// citation aside is never split mid-thought) and shown verbatim, in the source's own
// order — sequence preserves that order without asserting a date we can't verify we
// parsed correctly. "Present missing intervals as gaps" (§6) is honestly not attempted
// here: it needs clean date ranges per owner, which parsing this prose reliably enough to
// assert doesn't clear this project's evidentiary bar.
// "unreviewed" | "approved" | "flagged" — §9 item 7 requires reviewing "sensitive or
// uncertain relationships, attribution, provenance, and image rights" before publishing.
// Every other editorial surface here (relationships, assertions, images) goes through
// /admin or a hand-verified publish script; these rows were originally auto-published
// straight from AIC's raw text with no review gate at all — added in the ticket 25
// follow-up. New rows default to "unreviewed" and still display (this is real,
// verbatim museum-published text, not a fabricated or inferred claim, so hiding it
// pending review would suppress real information over a low real risk) — but an admin
// can now flag a specific segment to hide it, same shape as ImageAsset.removedAt.
model OwnershipEvent {
  id               String   @id @default(cuid())
  physicalObjectId String
  sequence         Int
  description      String
  sourceId         String
  retrievedAt      DateTime
  reviewStatus     String   @default("unreviewed")

  physicalObject PhysicalObject @relation(fields: [physicalObjectId], references: [id])
  source         Source         @relation(fields: [sourceId], references: [id])

  @@unique([physicalObjectId, sequence])
  @@index([physicalObjectId])
}

// Covers §10's "Exhibition/LoanEvent" as one model — AIC's `exhibition_history` field
// documents exhibitions only; no source here gives structured loan-specific data (a
// current/temporary loan feed), so "loan" as a distinct sub-type isn't populated. Same
// segment-preservation approach as OwnershipEvent, but split on the source's own blank
// lines (confirmed live: each exhibition entry is its own paragraph), which is a much
// more reliable boundary than provenance_text's semicolon-in-prose format.
model ExhibitionEvent {
  id               String   @id @default(cuid())
  physicalObjectId String
  sequence         Int
  description      String
  sourceId         String
  retrievedAt      DateTime
  reviewStatus     String   @default("unreviewed")

  physicalObject PhysicalObject @relation(fields: [physicalObjectId], references: [id])
  source         Source         @relation(fields: [sourceId], references: [id])

  @@unique([physicalObjectId, sequence])
  @@index([physicalObjectId])
}

model Artist {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artworks Artwork[]
}

model MovementStyle {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  // "period" | "movement" | "technique" | "style" — kept as a plain string rather than an
  // enum so editorial content can name a new kind without a migration; validated in app code.
  kind      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artworks ArtworkMovement[]
}

model ArtworkMovement {
  artworkId  String
  movementId String

  artwork  Artwork       @relation(fields: [artworkId], references: [id])
  movement MovementStyle @relation(fields: [movementId], references: [id])

  @@id([artworkId, movementId])
}

model Institution {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  physicalObjects PhysicalObject[]
}

model ImageAsset {
  id               String    @id @default(cuid())
  physicalObjectId String
  sourceUrl        String
  credit           String?
  rightsUrl        String?
  eligibleUses     String?
  altText          String?
  // Soft-delete: an admin can remove an ineligible image (ticket 05) without deleting the
  // PhysicalObject/Artwork it belongs to. Null = active; set = removed, kept for audit.
  removedAt        DateTime?

  physicalObject PhysicalObject @relation(fields: [physicalObjectId], references: [id])

  @@index([physicalObjectId])
}

model Source {
  id        String   @id @default(cuid())
  name      String
  url       String
  createdAt DateTime @default(now())

  assertions       Assertion[]
  relationships    Relationship[]
  ownershipEvents  OwnershipEvent[]
  exhibitionEvents ExhibitionEvent[]
}

// Polymorphic fact table: one row per (subject, field, competing value). subjectType +
// subjectId identify the entity the field belongs to (e.g. subjectType: "Artwork",
// field: "creationDate"). value carries the original source wording verbatim; the
// earliest/latest/precision trio is the sortable, filterable interpretation of that same
// fact, used for date fields (see ticket 02 acceptance: display text alongside sortable
// earliest/latest + precision).
model Assertion {
  id              String    @id @default(cuid())
  subjectType     String
  subjectId       String
  field           String
  value           String
  valueEarliest   DateTime?
  valueLatest     DateTime?
  // "exact" | "approximate" | "disputed" — plain string for the same reason as
  // MovementStyle.kind.
  precision       String?
  sourceId        String
  retrievedAt     DateTime
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  isPreferred     Boolean   @default(false)
  selectionReason String?
  createdAt       DateTime  @default(now())

  source Source @relation(fields: [sourceId], references: [id])

  @@index([subjectType, subjectId, field])
}

// Raised when bulk ingestion (ticket 05) sees a new source record whose title slugifies
// to an existing Artwork's slug, but whose externalRecordUrl doesn't match any of that
// Artwork's existing PhysicalObjects — i.e. same title, not proven to be the same work.
// The ingest writer always creates a separate, disambiguated Artwork in this case and
// raises a flag rather than guessing; a human resolves it (or ticket 09's related-piece
// research supersedes it with a verified Relationship).
model DuplicateFlag {
  id         String    @id @default(cuid())
  artworkAId String
  artworkBId String
  reason     String
  // "pending" | "confirmed_distinct" | "confirmed_duplicate" — plain string, same
  // rationale as MovementStyle.kind and Assertion.precision.
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  artworkA Artwork @relation("DuplicateFlagArtworkA", fields: [artworkAId], references: [id])
  artworkB Artwork @relation("DuplicateFlagArtworkB", fields: [artworkBId], references: [id])

  @@index([status])
}

// One row per source record bulk ingestion (ticket 05) attempted, success or failure —
// "logging sync failures, last success, missing rights, and stale records" (§9).
model IngestLog {
  id         String   @id @default(cuid())
  sourceName String
  externalId String
  // "success" | "failure" | "flagged_duplicate"
  status     String
  message    String?
  artworkId  String?
  createdAt  DateTime @default(now())

  @@index([sourceName, externalId])
  @@index([status])
}

// A verified relationship between two artworks (ticket 09 / master prompt §4, §10).
// Every row must be backed by a specific citable source discussing those two objects —
// never created from matching titles, subjects, or visual similarity alone. Direction
// matters for some types (subject is "the study", object is "the finished work" for
// preparatory_study; subject is "the copy", object is "the original" for copy_after);
// for symmetric types (same_series, another_version, pendant_companion,
// multi_part_work, documented_influence) direction is only bookkeeping.
model Relationship {
  id               String    @id @default(cuid())
  subjectArtworkId String
  objectArtworkId  String
  // "same_series" | "preparatory_study" | "another_version" | "pendant_companion" |
  // "multi_part_work" | "print_impression" | "cast_from_model" | "copy_after" |
  // "documented_influence" — plain string, same rationale as MovementStyle.kind.
  relationshipType String
  // Reader-facing sentence, written for a museum visitor, not art-history jargon.
  explanation      String
  evidenceSourceId String
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  createdAt        DateTime  @default(now())

  subjectArtwork Artwork @relation("RelationshipSubject", fields: [subjectArtworkId], references: [id])
  objectArtwork  Artwork @relation("RelationshipObject", fields: [objectArtworkId], references: [id])
  evidenceSource Source  @relation(fields: [evidenceSourceId], references: [id])

  @@unique([subjectArtworkId, objectArtworkId, relationshipType])
  @@index([subjectArtworkId])
  @@index([objectArtworkId])
}
