# Copy to .env and fill in for local development.
# Matches docker-compose.yml's postgres service by default.
DATABASE_URL="postgresql://art_atlas:art_atlas_dev@localhost:5432/art_atlas_dev"

# Ticket 19 — HTTP Basic Auth password gating /admin. Any username works; only this
# password is checked. Required for /admin to be reachable at all (fails closed if unset).
ADMIN_PASSWORD=""

# Ticket 31 — only needed to run `npm run cache:aic-images`. Get the real value from
# `.env.local` (written there by `vercel env pull` / `vercel blob create-store`) and copy
# it here — scripts load `.env`, not `.env.local`. Not needed for `npm run dev`.
BLOB_READ_WRITE_TOKEN=""
